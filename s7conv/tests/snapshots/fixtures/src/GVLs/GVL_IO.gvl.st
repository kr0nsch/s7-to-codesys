// Назначение: символьный слой входов/выходов S7: прямые адреса и теги с адресом → переменные с AT
// Автор:      s7conv 0.1.0 (сгенерировано)
// Версия:     не указана
// Документ:   docs/MAPPING.md, раздел «Адреса»
// Адресная модель: S7 нумерует байты (%IW64 — байты 64–65, big-endian), CODESYS — слова
// (%IW32 — байты 64–65, little-endian). Адреса ниже — заготовка: на ПЛК210 каналы модулей
// привязываются в дереве устройств (I/O mapping) — сверить с конфигурацией.
{attribute 'qualified_only'}
VAR_GLOBAL
    Start_PB AT %IX0.0 : BOOL; // S7 %I0.0; Кнопка «Пуск»
    Stop_PB AT %IX0.1 : BOOL; // S7 %I0.1; Кнопка «Стоп» (NC)
    I0_2 AT %IX0.2 : BOOL; // S7 %I0.2
    Level_Raw AT %IW32 : INT; // S7 %IW64; Уровень, сырое значение
    Motor_Run AT %QX0.0 : BOOL; // S7 %Q0.0; Пускатель двигателя
    Horn AT %QX0.1 : BOOL; // S7 %Q0.1; Сирена
    Q4_0 AT %QX4.0 : BOOL; // S7 %Q4.0
END_VAR
