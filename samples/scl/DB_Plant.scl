DATA_BLOCK "DB_LT101" "FB_AnalogIn"
BEGIN
   rangeHigh := 5.0;
   limitHH := 4.8;
   limitH := 4.5;
   limitL := 1.0;
   limitLL := 0.5;
   hysteresis := 0.05;
