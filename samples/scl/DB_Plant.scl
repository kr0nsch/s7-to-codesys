DATA_BLOCK "DB_FT101" "FB_AnalogIn"
BEGIN
   rangeHigh := 1200.0;
   limitHH := 1150.0;
   limitH := 1100.0;
   limitL := 0.0;
   limitLL := -1.0;
   hysteresis := 10.0;
END_DATA_BLOCK

