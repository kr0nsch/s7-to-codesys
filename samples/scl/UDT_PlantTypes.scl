// =============================================================================
// s7-to-codesys — корпус SCL. Написан с нуля для проекта, это не выгрузка
// реального объекта. Вымышленный объект: ВОС «Северная» — насосная станция
// II подъёма, скорые фильтры, дозирование реагента.
//
// Файл:   UDT_PlantTypes.scl
// Блоки:  TYPE "UDT_AnalogCfg", TYPE "UDT_DeviceStatus", TYPE "UDT_DosingRecipe"
// -----------------------------------------------------------------------------
// Назначение
//   Пользовательские типы данных (PLC data types) станции. Логики нет.
//   UDT_AnalogCfg    — параметры аналогового канала: шкала, уставки (вложенная
//                      структура limits), гистерезис, единица измерения.
//   UDT_DeviceStatus — состояние устройства для HMI: работа, авария, режим,
//                      код аварии, число пусков. Его заполняет FB_Motor.
//   UDT_DosingRecipe — рецепт дозирования: имя (String[20]), реагент, дозы по
//                      ступеням (Array[1..4] of Real), время контакта (Time),
//                      отметка изменения (Date_And_Time), признак утверждения.
// Что проверяет при конвертации
//   TYPE/STRUCT/END_STRUCT; вложенная анонимная Struct; массив в структуре с
//   инициализатором [..] и множителем повторения; значения по умолчанию;
//   String[n] -> STRING(n); Date_And_Time -> DT; Time -> TIME.
// =============================================================================
TYPE "UDT_AnalogCfg"
VERSION : 0.1
   STRUCT
      rangeLow : Real := 0.0;   // Значение при raw = 0, инж. ед.
      rangeHigh : Real := 16.0;   // Значение при raw = 27648, инж. ед.
      limits : Struct   // Уставки сигнализации, инж. ед.
         hh : Real := 14.0;   // Аварийно высокое
         h : Real := 12.0;   // Предупредительно высокое
         l : Real := 2.0;   // Предупредительно низкое
         ll : Real := 1.0;   // Аварийно низкое
      END_STRUCT;
      hysteresis : Real := 0.5;   // Гистерезис уставок, инж. ед.
      unitText : String[8] := 'bar';   // Единица измерения для HMI
   END_STRUCT;

END_TYPE

TYPE "UDT_DeviceStatus"
VERSION : 0.1
   STRUCT
      running : Bool;   // Работает (команда и обратная связь)
      fault : Bool;   // Авария (защёлка)
      autoMode : Bool;   // Режим авто
      faultCode : Int;   // 0 — нет, 1 — нет ОС после пуска, 2 — пропала ОС, 3 — тепловая защита, 4 — ОС без команды
      startCount : DInt;   // Число пусков
   END_STRUCT;

END_TYPE

TYPE "UDT_DosingRecipe"
VERSION : 0.2
   STRUCT
      name : String[20] := 'DEFAULT';   // Имя рецепта
      reagent : Int := 1;   // 1 — коагулянт, 2 — флокулянт, 3 — гипохлорит
      doseStep : Array[1..4] of Real := [0.5, 1.0, 1.5, 2.0];   // Доза по ступеням расхода, мг/л
      stepFlow : Array[1..4] of Real := [4(0.0)];   // Границы ступеней расхода, м3/ч (задаются с HMI)
      contactTime : Time := T#15M;   // Время контакта
      changedAt : Date_And_Time := DT#2024-01-01-00:00:00;   // Когда изменён
      approved : Bool;   // Утверждён технологом
   END_STRUCT;

END_TYPE

