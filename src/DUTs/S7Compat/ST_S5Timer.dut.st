// Назначение: состояние таймера S5 (слово таймера T n S7-300/400) для кода, сконвертированного s7conv из STL:
//             пуск SP, SE, SD, SS, SF, разрешение FR, сброс R, опрос A T, L T, LC T. В S7 таймер — глобальный
//             объект CPU, поэтому состояния лежат в генерируемом GVL_S5Timers (массив aTimer, индекс — номер
//             таймера), а инструкции — функции F_S5* с VAR_IN_OUT. Время — F_S7Now(): в работе TIME(), в
//             тестах — моделируемые часы GVL_S7Clock. Остаток пересчитывается при каждом обращении к таймеру
//             (в S7 его уменьшает часовой процесс CPU асинхронно циклу).
// Автор:      kr0nsch
// Версия:     1.2.0
// Документ:   docs/MAPPING_STL.md, правило s5.timebase; docs/ASSUMPTIONS.md, записи L13–L16
TYPE ST_S5Timer :
STRUCT
    xRunning : BOOL;    // таймер идёт
    xQ : BOOL;          // состояние таймера (опрос A T n)
    xRloStart : BOOL;   // RLO последней инструкции пуска — память фронта пуска (FR её сбрасывает)
    xRloFree : BOOL;    // RLO последней инструкции FR — память фронта разрешения
    xQAtEnd : BOOL;     // состояние по истечении времени: TRUE — SD, SS; FALSE — SP, SE, SF
    tStart : TIME;      // момент пуска (F_S7Now)
    tPreset : TIME;     // заданное время: значение × шкала
    tRest : TIME;       // остаток времени (у остановленного таймера — на момент остановки)
    wBase : WORD;       // шкала времени: 0 — 10 мс, 1 — 100 мс, 2 — 1 с, 3 — 10 с
END_STRUCT
END_TYPE
