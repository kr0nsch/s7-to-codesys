// Назначение: состояние счётчика S5 (слово счётчика C n S7-300/400) для кода, сконвертированного s7conv из
//             STL: CU, CD, установка S, сброс R, разрешение FR, опрос A C, L C, LC C. Значение 0…999; у
//             каждой инструкции, работающей по фронту RLO, своя память фронта. Состояния лежат в
//             генерируемом GVL_S5Counters (массив aCounter, индекс — номер счётчика).
// Автор:      kr0nsch
// Версия:     1.2.0
// Документ:   docs/MAPPING_STL.md, правило s5.counter
TYPE ST_S5Counter :
STRUCT
    iValue : INT;       // значение счётчика, 0…999
    xRloUp : BOOL;      // RLO последней инструкции CU — память фронта
    xRloDown : BOOL;    // RLO последней инструкции CD — память фронта
    xRloSet : BOOL;     // RLO последней инструкции S — память фронта
    xRloFree : BOOL;    // RLO последней инструкции FR — память фронта разрешения
END_STRUCT
END_TYPE
