// Назначение: значение 0…999 из трёх младших тетрад BCD слова (значение S5TIME без шкалы, установка
//             счётчика S5). Старшая тетрада (шкала времени) не учитывается. Нецифровые тетрады (в S7 —
//             ошибка программы при пуске таймера или установке счётчика) считаются как есть.
// Автор:      kr0nsch
// Версия:     1.2.0
// Документ:   docs/MAPPING_STL.md, правила s5.timebase и s5.counter
FUNCTION F_S5FromBcd : INT
VAR_INPUT
    wBcd : WORD;    // слово BCD: биты 0–3 — единицы, 4–7 — десятки, 8–11 — сотни
END_VAR
VAR
    wUnits : WORD;      // тетрада единиц
    wTens : WORD;       // тетрада десятков
    wHundreds : WORD;   // тетрада сотен
END_VAR
VAR CONSTANT
    NIBBLE : WORD := 16#F;      // маска тетрады
    TENS_SHIFT : INT := 4;      // сдвиг тетрады десятков
    HUNDREDS_SHIFT : INT := 8;  // сдвиг тетрады сотен
    TEN : INT := 10;            // вес десятков
    HUNDRED : INT := 100;       // вес сотен
END_VAR
