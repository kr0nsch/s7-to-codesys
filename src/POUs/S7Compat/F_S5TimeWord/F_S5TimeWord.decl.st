// Назначение: слово S5TIME из TIME — содержимое ACCU1-L для пуска таймера S5 (биты 0–11 — значение в BCD
//             0…999, биты 12–13 — шкала). Шкала выбирается, как у литерала S5T#: наименьшая, в которую
//             помещается время (10 мс — до 9,99 с, 100 мс — до 99,9 с, 1 с — до 999 с, 10 с — до 9990 с);
//             значение округляется вниз до шкалы (AWL_e.pdf, §12.2). Больше 2H46M30S — 999 единиц по 10 с.
// Автор:      kr0nsch
// Версия:     1.2.0
// Документ:   docs/MAPPING_STL.md, правило s5.timebase
FUNCTION F_S5TimeWord : WORD
VAR_INPUT
    tTime : TIME;   // время (литерал S5T# исходника переведён в T#)
END_VAR
VAR
    udiMs : UDINT;      // время, мс
    wBase : WORD;       // код шкалы
    udiBaseMs : UDINT;  // единица шкалы, мс
    udiUnits : UDINT;   // значение в единицах шкалы
    iUnits : INT;       // то же, INT
END_VAR
VAR CONSTANT
    LIMIT_10MS : UDINT := 9990;     // наибольшее время со шкалой 10 мс
    LIMIT_100MS : UDINT := 99900;   // наибольшее время со шкалой 100 мс
    LIMIT_1S : UDINT := 999000;     // наибольшее время со шкалой 1 с
    BASE_10S : WORD := 3;           // код шкалы 10 с
    MAX_UNITS : UDINT := 999;       // наибольшее значение из трёх тетрад BCD
    BASE_SHIFT : INT := 12;         // сдвиг кода шкалы
END_VAR
